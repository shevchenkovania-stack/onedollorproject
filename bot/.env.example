BOT_TOKEN=
ADMIN_IDS=
DB_PATH=/opt/imobiliare/data/imobiliare.db
PHOTOS_DIR=/opt/imobiliare/data/photos
DEFAULT_CURRENCY=EUR

# Positioning focus: be one useful service, not "yet another board". Leave both empty for the
# full board; set them to narrow the whole product (Mini App search + submit are locked, sale/
# other-room ads are hidden and rejected server-side). Nothing is deleted - flip back to "" anytime.
# Prod example: one-bedroom rentals in Chisinau, from owners, no agents.
FOCUS_DEAL=
FOCUS_ROOMS=

# Paid product: Boost = listing pinned first in search for N days, price in Telegram Stars.
# Seller reward is $0.013 per Star (Telegram dev terms 6.2.4), so 400 Stars ~= $5.20: keep every
# rail in the same money range, otherwise buyers always walk into the cheapest loophole.
BOOST_STARS=400
BOOST_DAYS=7

# Rail 2: instant transfer in MDL, activated by an admin after the money really arrives.
# Works in Moldova without an acquiring contract and without a merchant account. 0 = option hidden.
BOOST_MDL=100
# MIA (BNM instant payments): the buyer sends money to THIS phone number from their banking app.
# Set it and the bot switches the rail to the MIA instructions with a tap-to-copy block.
PAY_PHONE=
# Name the buyer must see on the confirmation screen (proof they are paying the right person).
PAY_NAME=
# Any other details as free text, e.g. "карта 5199 0000 0000 0000, maib, Ivan P."
PAY_INFO=

# Rail 3: real Visa/Mastercard via Lemon Squeezy (merchant of record, Moldova is a supported
# payout country). All four values come from the LS dashboard:
#   LS_API_KEY   Settings -> API keys;  LS_STORE_ID  store id in the URL; LS_VARIANT_ID
#   Products -> your product -> variant id;  LS_WEBHOOK_SECRET  Settings -> Webhooks -> secret
# Webhook endpoint https://<public-https-host>/webhook/lemonsqueezy is registered by the API, not
# by hand: deploy/register_ls_webhook.py (needed because a tunnel URL changes on every restart).
LS_API_KEY=
LS_STORE_ID=
LS_VARIANT_ID=
LS_WEBHOOK_SECRET=
# Boost price on the checkout, in cents of the store currency (500 = $5.00)
CARD_PRICE_CENTS=500

# Revenue loop: DM the owner of a live, non-boosted listing with a Boost offer
NUDGE_AFTER_DAYS=2
NUDGE_COOLDOWN_DAYS=4
NUDGE_INTERVAL_HOURS=6

# Founders gift: first GIFT_SLOTS approved publishers receive GIFT_BOOSTS free top-raises each.
# 1 raise = try once (7 days top) -> buy the next (100 MDL). GIFT_BOOSTS=0 disables the program.
GIFT_BOOSTS=1
GIFT_SLOTS=10

# Public channel for auto-posting approved listings (@username or -100xxxxxxxxxx id)
CHANNEL_ID=
# Bot username, used for "post your own listing" CTA buttons in channel posts
BOT_USERNAME=
# HTTPS url of the Telegram Mini App, e.g. https://imobil.example.md (empty -> button hidden).
# The same host must be publicly reachable for the LS payment webhook to work.
WEBAPP_URL=
# Optional support contact used by /paysupport
CONTACT_URL=
