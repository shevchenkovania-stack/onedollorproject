# deploy/outreach.env — credentials for cold B2B email outreach. Copy to outreach.env
# (same folder, git-ignored) and fill. NEVER commit the filled file.
#
# Use an APPLICATION PASSWORD from a dedicated outreach mailbox, not your main password:
#   Gmail  -> security -> 2-Step Verification -> App passwords (16 chars, spaces optional)
#   Яндекс -> "Пароли приложений" (SMTP + IMAP enabled in settings)
# The mailbox should be new/clean and used only for outreach: a spam-flagged personal inbox
# costs you your real email, not just the campaign.

SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SSL=1
SMTP_USER=
SMTP_PASS=

# Display name the recipient sees. A human + brand, not "no-reply".
MAIL_FROM_NAME=Иван · Однушка.md
# Answers must land in a real inbox, or the campaign converts into nothing.
MAIL_REPLY_TO=
# One link per email, tagged so events.start.meta shows whether mail works as a channel.
MAIL_BOT_URL=https://t.me/gaseste_casa_bot?start=mail
# Last line of the body: how to reach you outside email (TG/WA phone works better than a form).
MAIL_CONTACT=Однушка.md · доска однушек Кишинёва в Telegram

# Addresses per day, walked in queue order. A fresh mailbox sending cold B2B gets throttled or
# banned well before Gmail's documented 500/day: keep this small until replies prove the domain
# is warm. The run refuses to exceed it, and the ledger guarantees no address is written twice.
DAILY_CAP=12

# Optional: ledger path (default deploy/outreach_ledger.jsonl). Point it at the VPS data dir if
# you run this from the server so the sent-list survives a redeploy.
# OUTREACH_LEDGER=/opt/imobiliare/data/outreach_ledger.jsonl
